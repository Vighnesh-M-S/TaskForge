# Copy to .env and fill in ONE key: cp .env.example .env
# The first key that is set wins, in this order.

# xAI Grok (keys start with "xai-") - https://console.x.ai
XAI_API_KEY=

# Groq (keys start with "gsk_") - https://console.groq.com
GROQ_API_KEY=

# Anthropic Claude
ANTHROPIC_API_KEY=

# Optional: force a provider (xai | groq | anthropic) and/or override its default model
# (defaults: grok-4.7, openai/gpt-oss-20b, claude-sonnet-5-5)
# TASKFORGE_PROVIDER=xai
# TASKFORGE_MODEL=grok-4.7

# Web interface only: require this password to run tasks. Set it before hosting publicly.
# TASKFORGE_PASSWORD=
